                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Details}" Opacity="0.74" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </local:HarborGlassCard>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                    </local:HarborGlassCard>
                                    <StackPanel Grid.Row="3" Spacing="9">
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                            <ComboBox x:Name="ModFolderTarget" DisplayMemberPath="Id" MinWidth="190"
                                                      PlaceholderText="选择目标实例" AutomationProperties.Name="导入到实例" />
                                            <Button Grid.Column="1" Style="{StaticResource HarborPill}" Content="移除所选" Click="RemoveFolderMods_Click" />
                                            <Button Grid.Column="2" Style="{StaticResource HarborProminentPill}" Content="导入所选到实例" Click="InstallFolderMods_Click" />
                                        </Grid>
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                            <Button Style="{StaticResource HarborPill}" Content="删除模组夹" Click="DeleteModFolder_Click" />
                                            <TextBlock Grid.Column="1" x:Name="ModFolderStatus" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            <Button Grid.Column="2" x:Name="CancelModFolderButton" Style="{StaticResource HarborPill}"
                                                    Content="取消任务" Click="CancelCatalog_Click" IsEnabled="False" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </local:HarborGlassCard>
                        </Grid>
                </Grid>
            </Grid>
        </Grid>
        <Grid x:Name="WindowChromeOverlay" Height="28" VerticalAlignment="Top">
            <Border Margin="70,0,0,0" Background="Transparent"
                    PointerPressed="ChromeDrag_PointerPressed" DoubleTapped="ChromeDrag_DoubleTapped" />
            <StackPanel x:Name="WindowControlGroup" Orientation="Horizontal" Spacing="0"
                        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,2,0,0"
                        PointerEntered="ChromeButtons_PointerEntered" PointerExited="ChromeButtons_PointerExited">
                <Button x:Name="ChromeCloseButton" Width="20" Height="24" Padding="0" Background="Transparent"
                        BorderThickness="0" CornerRadius="10" Click="ChromeClose_Click" GotFocus="ChromeButton_Focused" LostFocus="ChromeButton_LostFocus"
                        ToolTipService.ToolTip="关闭"
                        AutomationProperties.Name="关闭 MC Harbor">
                    <Grid Width="12" Height="12">
                        <Border x:Name="ChromeCloseDot" CornerRadius="6" Background="#E1695D" />
                        <TextBlock x:Name="ChromeCloseGlyph" Text="×" FontSize="9" FontWeight="Bold" Foreground="#552D1715"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" />
                    </Grid>
                </Button>
                <Button x:Name="ChromeMinimizeButton" Width="20" Height="24" Padding="0" Background="Transparent"
                        BorderThickness="0" CornerRadius="10" Click="ChromeMinimize_Click" GotFocus="ChromeButton_Focused" LostFocus="ChromeButton_LostFocus"
                        ToolTipService.ToolTip="最小化"
                        AutomationProperties.Name="最小化 MC Harbor">
                    <Grid Width="12" Height="12">
                        <Border x:Name="ChromeMinimizeDot" CornerRadius="6" Background="#F4C536" />
                        <TextBlock x:Name="ChromeMinimizeGlyph" Text="−" FontSize="9" FontWeight="Bold" Foreground="#55442F00"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" />
                    </Grid>
                </Button>
                <Button x:Name="ChromeMaximizeButton" Width="20" Height="24" Padding="0" Background="Transparent"
                        BorderThickness="0" CornerRadius="10" Click="ChromeMaximize_Click" GotFocus="ChromeButton_Focused" LostFocus="ChromeButton_LostFocus"
                        ToolTipService.ToolTip="最大化"
                        AutomationProperties.Name="最大化 MC Harbor">
                    <Grid Width="12" Height="12">
                        <Border x:Name="ChromeMaximizeDot" CornerRadius="6" Background="#65BE36" />
                        <TextBlock x:Name="ChromeMaximizeGlyph" Text="□" FontSize="8" FontWeight="Bold" Foreground="#55304A20"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" />
                    </Grid>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
